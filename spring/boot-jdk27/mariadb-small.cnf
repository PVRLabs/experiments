# One bounded follow-up profile for a small InnoDB single-VPS deployment.
# No JVM or SQL changes are part of this database profile.
[mariadbd]
bind-address=127.0.0.1
innodb_buffer_pool_size=64M
default_time_zone='+00:00'
# Conservative caches for engines not used by the application's InnoDB tables.
key_buffer_size=8M
aria_pagecache_buffer_size=16M
