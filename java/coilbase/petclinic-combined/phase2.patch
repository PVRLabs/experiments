+				case "owner-new" -> "New Owner Created";
+				case "owner-edit" -> "Owner Values Updated";
+				case "pet-new" -> "New Pet has been Added";
+				case "pet-edit" -> "Pet details has been edited";
+				case "visit-new" -> "Your visit has been booked";
+				default -> null;
+			};
+			if (message != null) {
+				model.put("message", message);
+			}
+		}
+		render(c, "owners/ownerDetails", model);
+	}
+
+	private static void redirectWithFlash(Context c, Owner owner, String code) {
