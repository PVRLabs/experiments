+++ b/src/main/java/org/springframework/samples/petclinic/ClinicAssets.java
@@ -0,0 +1,53 @@
+package org.springframework.samples.petclinic;
+
+import io.avaje.jex.Jex;
+import io.avaje.jex.http.Context;
+
+final class ClinicAssets {
+
+	private ClinicAssets() {
+	}
+
+	static void register(Jex jex) {
+		mount(jex, "/resources/", "static/resources/", "css/petclinic.css",
+				"images/pets.png", "images/favicon.png", "images/spring-logo.svg",
+				"images/spring-logo-dataflow.png", "images/spring-logo-dataflow-mobile.png",
+				"fonts/varela_round-webfont.svg", "fonts/varela_round-webfont.woff",
+				"fonts/varela_round-webfont.eot", "fonts/varela_round-webfont.ttf",
+				"fonts/montserrat-webfont.svg", "fonts/montserrat-webfont.woff",
+				"fonts/montserrat-webfont.eot", "fonts/montserrat-webfont.ttf");
+		mount(jex, "/webjars/bootstrap/", "META-INF/resources/webjars/bootstrap/5.3.8/",
+				"dist/js/bootstrap.bundle.min.js", "dist/js/bootstrap.bundle.min.js.map");
+		mount(jex, "/webjars/font-awesome/", "META-INF/resources/webjars/font-awesome/4.7.0/",
+				"css/font-awesome.min.css", "fonts/fontawesome-webfont.woff2", "fonts/fontawesome-webfont.woff",
+				"fonts/fontawesome-webfont.eot", "fonts/fontawesome-webfont.svg", "fonts/fontawesome-webfont.ttf",
+				"fonts/FontAwesome.otf");
+	}
+
+	private static void mount(Jex jex, String route, String resource, String... files) {
+		for (String file : files) {
+			jex.get(route + file, c -> serve(c, resource + file));
+		}
+	}
+
+	private static void serve(Context c, String resource) throws java.io.IOException {
+		try (var body = ClinicAssets.class.getClassLoader().getResourceAsStream(resource)) {
+			if (body == null) {
+				c.writeEmpty(404);
+				return;
+			}
+			String extension = resource.substring(resource.lastIndexOf('.') + 1);
+			String media = switch (extension) {
+				case "png" -> "image/png";
+				case "svg" -> "image/svg+xml";
+				case "css" -> "text/css";
+				case "js" -> "text/javascript";
+				case "map" -> "application/json";
+				case "eot" -> "application/vnd.ms-fontobject";
+				default -> "font/" + extension;
+			};
+			c.header("Cache-Control", "max-age=43200").contentType(media).write(body);
+		}
+	}
+
+}
