+		}
+		return pet;
+	}
+
+	private static int id(Context c, String name) {
+		return number(c.pathParam(name));
+	}
+
+	private static int number(String value) {
+		try {
+			return Integer.parseInt(value);
+		}
+		catch (NumberFormatException ex) {
+			throw new BadInput("Expected an integer");
+		}
+	}
+
+	private static LocalDate parseDate(String date, String field, Map<String, String> errors) {
+		if (date.isEmpty()) {
+			return null;
+		}
+		try {
+			return LocalDate.parse(date);
+		}
+		catch (DateTimeParseException ex) {
+			errors.put(field, "Invalid date");
+			return null;
+		}
+	}
+
+	private void render(Context c, String name, Map<String, Object> model) {
+		var variables = new HashMap<String, Object>();
+		variables.put("errors", Map.of());
+		variables.putAll(model);
+		c.html(templates.process(name, new org.thymeleaf.context.Context(locale(c), variables)));
+	}
+
+	private void error(Context c, int status, String message) {
+		c.status(status);
+		render(c, "error", Map.of("status", status, "message", message));
+	}
+
+	private static Locale locale(Context c) {
+		try {
+			String accept = c.header("Accept-Language");
+			if (accept != null) {
+				var ranges = Locale.LanguageRange.parse(accept);
+				Locale match = Locale.lookup(ranges, java.util.List.of(Locale.ENGLISH, Locale.GERMAN,
+						Locale.forLanguageTag("es"), Locale.forLanguageTag("fa"), Locale.forLanguageTag("hi"),
+						Locale.JAPANESE, Locale.KOREAN,
+						Locale.forLanguageTag("pt"), Locale.forLanguageTag("ru"), Locale.forLanguageTag("tr")));
+				if (match != null) {
+					return match;
+				}
+			}
+		}
+		catch (IllegalArgumentException ignored) {
+		}
+		return Locale.ENGLISH;
+	}
+
+	private static String message(Context c, String key) {
+		return ResourceBundle.getBundle("messages.messages", locale(c)).getString(key);
+	}
+
+	private static String ownerPath(Owner owner) {
+		return "/owners/" + owner.getId();
+	}
+
+	private static String text(Object value) {
+		return value == null ? "" : value.toString();
+	}
+
+	private static void redirect(Context c, String path) {
+		c.redirect(path, 302);
+	}
+
+	@Override
+	public void close() {
+		validation.close();
+	}
+
+	private static final class BadInput extends RuntimeException {
+		BadInput(String message) { super(message); }
+	}
+
+	private static final class MissingRecord extends RuntimeException {
+		MissingRecord(String message) { super(message); }
+	}
+
+}
