+	private void findOwners(Context c) {
+		String name = decodeForm(c.uri().getRawQuery()).getOrDefault("lastName", "").strip();
+		int number = pageNumber(c);
+		var result = owners.findByLastNameStartingWith(name, page(number));
+		if (number < 1 || number > Math.max(result.getTotalPages(), 1)) {
+			redirect(c, "/owners?page=1" + (name.isEmpty() ? "" : "&lastName="
+					+ URLEncoder.encode(name, StandardCharsets.UTF_8)));
+		}
+		else if (result.isEmpty()) {
+			var owner = new Owner();
+			owner.setLastName(name);
+			render(c, "owners/findOwners", Map.of("owner", owner, "errors", Map.of("lastName", "not found")));
+		}
+		else if (result.getTotalElements() == 1) {
+			redirect(c, ownerPath(result.getContent().getFirst()));
+		}
+		else {
+			render(c, "owners/ownersList", listing(number, result, "listOwners"));
+		}
+	}
+
+	private void showVets(Context c) {
+		int number = pageNumber(c);
+		var result = vets.findAll(page(number));
+		if (number < 1 || number > Math.max(result.getTotalPages(), 1)) {
+			redirect(c, "/vets.html?page=1");
+		}
+		else {
+			render(c, "vets/vetList", listing(number, result, "listVets"));
+		}
+	}
+
+	private static Map<String, Object> listing(int number, Page<?> page, String name) {
+		return Map.of("currentPage", number, "totalPages", page.getTotalPages(),
+				"totalItems", page.getTotalElements(), name, page.getContent());
+	}
+
+	private static PageRequest page(int number) {
+		return PageRequest.of(Math.max(1, number) - 1, 5);
+	}
+
+	private int pageNumber(Context c) {
+		return number(decodeForm(c.uri().getRawQuery()).getOrDefault("page", "1"));
+	}
+
+	private void showOwner(Context c) {
