+	private void vetResources(Context c) throws JAXBException {
+		String header = c.header("Accept");
+		var accept = header == null ? java.util.List.of(MediaType.ALL) : MediaType.parseMediaTypes(header);
+		double json = quality(accept, MediaType.APPLICATION_JSON);
+		double xmlQuality = quality(accept, MediaType.APPLICATION_XML);
+		if (json <= 0 && xmlQuality <= 0) {
+			c.writeEmpty(406);
+			return;
+		}
+		var result = new Vets();
+		result.getVetList().addAll(vets.findAll());
+		if (json >= xmlQuality) {
+			c.json(result);
+		}
+		else {
+			var body = new StringWriter();
+			xml.createMarshaller().marshal(result, body);
+			c.contentType("application/xml").write(body.toString());
+		}
+	}
+
+	private static double quality(java.util.List<MediaType> accept, MediaType offered) {
+		return accept.stream()
+			.filter(type -> type.includes(offered))
+			.max(java.util.Comparator.<MediaType>comparingInt(ClinicWeb::specificity)
+				.thenComparingDouble(MediaType::getQualityValue))
+			.map(MediaType::getQualityValue)
+			.orElse(0.0);
+	}
+
+	private static int specificity(MediaType range) {
+		if (range.isWildcardType()) {
+			return 0;
+		}
+		if (range.isWildcardSubtype()) {
+			return 1;
+		}
+		return 2;
+	}
+
+	private static JAXBContext vetXml() {
+		try {
+			return JAXBContext.newInstance(Vets.class);
+		}
+		catch (JAXBException ex) {
+			throw new IllegalStateException("Unable to configure vet XML", ex);
+		}
+	}
