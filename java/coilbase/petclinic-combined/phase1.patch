+import org.springframework.stereotype.Component;
+
+import pvrlabs.coilbase.RepositoryContext;
+import pvrlabs.coilbase.SqlStatement;
+
+@Component
+public class OwnerRepository {
+
+	private static final String OWNER_FIELDS = "id, first_name, last_name, address, city, telephone";
+
+	private final RepositoryContext db;
+
+	public OwnerRepository(RepositoryContext db) {
+		this.db = db;
+	}
+
+	public Optional<Owner> findById(Integer id) {
+		Objects.requireNonNull(id, "Owner ID is required");
+		return db.inTransaction(handle -> handle.createQuery("select " + OWNER_FIELDS + " from owners where id=:id")
+			.bind("id", id)
+			.mapToBean(Owner.class)
+			.findOne()
+			.map(owner -> loadPets(handle, owner)));
+	}
+
+	public Page<Owner> findByLastNameStartingWith(String name, Pageable pageable) {
+		String prefix = name.replace("!", "!!").replace("%", "!%").replace("_", "!_") + "%";
+		return db.inTransaction(handle -> {
+			String predicate = " from owners where last_name like :prefix escape '!'";
+			long total = handle.createQuery("select count(*)" + predicate)
+				.bind("prefix", prefix)
+				.mapTo(Long.class)
+				.one();
+			var query = handle
+				.createQuery("select " + OWNER_FIELDS + predicate + " order by id"
+						+ (pageable.isPaged() ? " limit :limit offset :offset" : ""))
+				.bind("prefix", prefix);
+			if (pageable.isPaged()) {
+				query.bind("limit", pageable.getPageSize()).bind("offset", pageable.getOffset());
+			}
+			return new PageImpl<>(
+					query.mapToBean(Owner.class).list().stream().map(owner -> loadPets(handle, owner)).toList(),
+					pageable, total);
+		});
+	}
+
+	private Owner loadPets(Handle handle, Owner owner) {
+		var pets = handle.createQuery("""
+				select p.id, p.name, p.birth_date, t.id as type_id, t.name as type_name
+				from pets p join types t on t.id=p.type_id
+				where p.owner_id=:ownerId order by p.name, p.id
+				""").bind("ownerId", owner.getId()).map((row, ctx) -> {
+			var pet = new Pet();
+			pet.setId(row.getInt("id"));
+			pet.setName(row.getString("name"));
+			pet.setBirthDate(row.getObject("birth_date", java.time.LocalDate.class));
+			var type = new PetType();
+			type.setId(row.getInt("type_id"));
+			type.setName(row.getString("type_name"));
+			pet.setType(type);
+			return pet;
+		}).list();
+		for (Pet pet : pets) {
+			handle.createQuery(
+					"select id, visit_date as date, description from visits where pet_id=:id order by visit_date, id")
+				.bind("id", pet.getId())
+				.mapToBean(Visit.class)
+				.list()
+				.forEach(pet::addVisit);
+			owner.addPet(pet);
+		}
+		return owner;
+	}
+
+	public Owner save(Owner owner) {
+		var assignments = new ArrayList<Runnable>();
+		write(() -> db.useTransaction(handle -> {
+			int id = writeOwner(handle, owner, assignments);
+			for (Pet pet : owner.getPets()) {
+				int petId = writePet(handle, id, pet, assignments);
+				for (Visit visit : pet.getVisits()) {
+					if (visit.isNew()) {
+						writeVisit(handle, petId, visit, assignments);
+					}
+				}
+			}
+		}));
+		assignments.forEach(Runnable::run);
+		return owner;
+	}
+
+	public Owner saveAndFlush(Owner owner) {
+		return save(owner);
+	}
+
+	public void saveDetails(Owner owner) {
+		var assignments = new ArrayList<Runnable>();
+		write(() -> db.useTransaction(handle -> writeOwner(handle, owner, assignments)));
+		assignments.forEach(Runnable::run);
+	}
+
+	public void savePet(int ownerId, Pet pet) {
+		var assignments = new ArrayList<Runnable>();
+		write(() -> db.useTransaction(handle -> writePet(handle, ownerId, pet, assignments)));
+		assignments.forEach(Runnable::run);
+	}
+
+	public void addVisit(int ownerId, int petId, Visit visit) {
+		int id = db.update(SqlStatement.of("""
+				insert into visits (pet_id, visit_date, description)
+				select id, :date, :description from pets where id=:petId and owner_id=:ownerId
+				"""),
+				update -> update.bind("date", visit.getDate())
+					.bind("description", visit.getDescription())
+					.bind("petId", petId)
+					.bind("ownerId", ownerId)
+					.executeAndReturnGeneratedKeys("id")
+					.mapTo(Integer.class)
+					.findOne()
+					.orElseThrow(() -> new IllegalArgumentException("Pet does not belong to owner")));
+		visit.setId(id);
+	}
+
+	private int writeOwner(Handle handle, Owner owner, List<Runnable> assignments) {
+		if (owner.isNew()) {
+			int id = key(handle.createUpdate("""
+					insert into owners (first_name,last_name,address,city,telephone)
+					values (:firstName,:lastName,:address,:city,:telephone)
+					""").bindBean(owner));
+			assignments.add(() -> owner.setId(id));
+			return id;
+		}
+		requireOne(handle.createUpdate("""
+				update owners set first_name=:firstName,last_name=:lastName,address=:address,
+					city=:city,telephone=:telephone where id=:id
+				""").bindBean(owner));
+		return owner.getId();
+	}
+
+	private int writePet(Handle handle, int ownerId, Pet pet, List<Runnable> assignments) {
+		int typeId = pet.getType() == null ? 0 : pet.getType().getId();
+		if (pet.isNew()) {
+			int id = key(handle.createUpdate("""
+					insert into pets (name,birth_date,type_id,owner_id) values (:name,:birthDate,:typeId,:ownerId)
+					""").bindBean(pet).bind("typeId", typeId).bind("ownerId", ownerId));
+			assignments.add(() -> pet.setId(id));
+			return id;
+		}
+		requireOne(handle.createUpdate("""
+				update pets set name=:name,birth_date=:birthDate,type_id=:typeId where id=:id and owner_id=:ownerId
+				""").bindBean(pet).bind("typeId", typeId).bind("ownerId", ownerId));
+		return pet.getId();
+	}
+
+	private void writeVisit(Handle handle, int petId, Visit visit, List<Runnable> assignments) {
+		int id = key(handle
+			.createUpdate("insert into visits (pet_id,visit_date,description) values (:petId,:date,:description)")
+			.bind("petId", petId)
+			.bindBean(visit));
+		assignments.add(() -> visit.setId(id));
+	}
+
+	private static int key(Update update) {
+		return update.executeAndReturnGeneratedKeys("id").mapTo(Integer.class).one();
+	}
+
+	private static void requireOne(Update update) {
+		if (update.execute() != 1) {
+			throw new IllegalArgumentException("Record does not exist or has a different owner");
+		}
+	}
+
+	private static void write(Runnable action) {
+		try {
+			action.run();
+		}
+		catch (JdbiException ex) {
+			if (ex.getCause() instanceof java.sql.SQLException sql && sql.getSQLState() != null
+					&& sql.getSQLState().startsWith("23")) {
+				throw new DataIntegrityViolationException(sql.getMessage(), ex);
+			}
+			throw ex;
+		}
+	}
 
 }
