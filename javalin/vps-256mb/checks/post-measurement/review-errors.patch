+package lab;
+
+/** Error-path responses; apply after the paired measurements. */
+public final class SqlErrors {
+    private SqlErrors() {}
+    public static int status(java.sql.SQLException error) {
+        String state = error.getSQLState();
+        return state != null && state.startsWith("23") ? 409 : 500;
+    }
+    public static String code(java.sql.SQLException error) {
+        return error.getSQLState() == null ? "unknown" : error.getSQLState();
+    }
+}
